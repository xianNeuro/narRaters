# Copy this file to .env and fill in the keys you need (the real .env is gitignored):
#   cp .env.example .env
#
# LLM API keys for the "API (LLM Call)" methods (steps 2 segment, 5 recall match,
# 6 causal rating). The platform is chosen automatically from the selected model:
# Claude/Anthropic models use ANTHROPIC_API_KEY; GPT/OpenAI models use OPENAI_API_KEY.
# You only need the key(s) for the provider(s) whose models you select.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Hugging Face (free, for the rMatch recall-matching method only):
# sign up at https://huggingface.co/join and create a read token at
# https://huggingface.co/settings/tokens
HF_TOKEN=
